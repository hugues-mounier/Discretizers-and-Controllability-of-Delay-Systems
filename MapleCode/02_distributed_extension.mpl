## =====================================================================
## Section 5.2 -- "A more elaborated example"
## Part 2: distributed extension Lambda_d^epsilon
##         (Subsection 5.2.1.2 of the book, ring R_d)
##
## R_d = R(d/dt)[e^{-L d/dt}, e^{L d/dt}] cap O is not a polynomial ring:
## OreModules cannot compute in it directly. We use its subring
##
##        S = R[d/dt, dd]  contained in R_d,
##        dd = (1 - e^{-L(d/dt - 1)}) / (d/dt - 1)   (distributed delay),
##
## which is a polynomial ring in two indeterminates (d/dt and dd are
## algebraically independent) and which contains Rex, since
##
##        e^{-L(d/dt - 1)} = E*delta = 1 - (Dt - 1)*dd.
##
## Any torsion element found over S remains a torsion element over R_d,
## and a free module over S yields a free module over R_d by extension of
## scalars: the conclusions obtained over S are transported to R_d.
##
## Maple conventions: Dt = d/dt, dd = distributed delay, E = e^{L}.
## =====================================================================

## Path to the OreModules library (to be adapted to the local installation):
## libname := "/path/to/OreModules", libname:
with(OreModules):
with(LinearAlgebra):
interface(screenwidth = 110):

S := DefineOreAlgebra(diff = [Dt, t], dual_shift = [dd, s],
                      polynom = [t, s], comm = [E]):

apply_to := (M, v) -> map(expand, convert(Matrix(M) . Vector(v), list)):

## Check: dd is an entire function of s (no pole at s = 1)
printf("dd(s) = (1 - exp(-L(s-1)))/(s-1), limit at s = 1: %a\n",
       limit((1 - exp(-L*(s - 1)))/(s - 1), s = 1));

for eps in [-1, 1] do

  printf("\n\n####################################################\n");
  printf("#####   epsilon = %2d   (ring S = R[Dt, dd])        #####\n", eps);
  printf("####################################################\n");

  ## 1 + epsilon e^{-L(d/dt-1)} expressed in S
  b := expand(1 + eps*(1 - (Dt - 1)*dd)):
  printf("\n1 + epsilon e^{-L(d/dt-1)} = %a\n", factor(b));

  ## --- Complete system (x1, x2, u)
  R := evalm([[Dt, -1, -b],
              [-1, Dt, -b]]):
  printf("\nPresentation matrix of Lambda_d (columns x1, x2, u):\n");
  print(R);
  m := [seq(factor(Determinant(DeleteColumn(Matrix(R), i))), i = 1 .. 3)]:
  printf("Minors of order 2: %a\n", m);
  printf("Gcd of the minors: %a\n", factor(gcd(gcd(m[1], m[2]), m[3])));
  printf("Rank of Lambda_d (= 3 - rank of P): %a\n", 3 - OreRank(R, S));

  ## --- Torsion
  e1 := Exti(Involution(R, S), S, 1):
  printf("\nExt^1: presentation of the torsion submodule Tor(Lambda_d)\n");
  print(e1[1]);
  printf("Generators of Tor(Lambda_d):\n");
  print(apply_to(e1[2], [x1, x2, u]));

  ## --- Decomposition (xi1, xi2, u)
  W := Matrix([[1, -1, 0], [1, 1, 0], [0, 0, 1]]):
  U := Matrix([[1, -1], [1, 1]]):
  Rdec := map(factor, U . Matrix(R) . MatrixInverse(W)):
  printf("\nSystem in the variables (xi1, xi2, u):\n");
  print(Rdec);

  ## --- Torsion-free part: parametrization of Lambda_d / Tor(Lambda_d)
  ## e1[3]: matrix Q such that Lambda_d / Tor(Lambda_d) = image of Q
  ## (x = Q xi, with xi arbitrary functions)
  printf("\nParametrization of Lambda_d / Tor(Lambda_d): (x1, x2, u)^T = Q xi, Q =\n");
  print(e1[3]);

  if eps = -1 then
    ## -------------------------------------------------------------
    ## epsilon = -1: 1 - e^{-L(d/dt-1)} = (Dt - 1) dd, hence
    ##   (Dt - 1)(xi2 - 2 dd u) = 0: xi2 - 2 dd u is a torsion element.
    ## Tor(Lambda_d) = [xi1, xi2 - 2 dd u] and Lambda_d / Tor = [u] is
    ## free of rank 1: Lambda_d is not a torsion module.
    ## -------------------------------------------------------------
    tau := expand((x1 + x2) - 2*dd*u):
    printf("\nElement xi2 - 2 dd u = %a\n", tau);
    printf("(Dt - 1)(xi2 - 2 dd u) reduced modulo the equations of the system:\n");
    ## Sum of the two equations: (Dt-1)(x1+x2) - 2 b u = 0
    printf("  %a\n", expand((Dt - 1)*tau - (Dt*x1 - x2 - b*u) - (-x1 + Dt*x2 - b*u)));
    printf("=> xi2 - 2 dd u is a torsion element, as xi1 = x1 - x2.\n");

    RF := evalm([[Dt - 1, -2*b]]):    # columns xi2, u
    printf("\nPart (xi2, u): %a\n", convert(RF, listlist));
    eF := Exti(Involution(RF, S), S, 1):
    printf("Ext^1 of the part (xi2, u) (nonzero torsion):\n");
    print(eF[1]);
    printf("Corresponding torsion element: %a\n",
           apply_to(eF[2], [xi2, u]));
    printf("Quotient by the torsion: generated by u alone, without relation\n");
    printf("=> free of rank 1, with basis u.\n");

  else
    ## -------------------------------------------------------------
    ## epsilon = 1: the part (xi2, u) is free over S, hence over R_d.
    ## -------------------------------------------------------------
    RF := evalm([[Dt - 1, -2*b]]):    # columns xi2, u
    printf("\nTorsion-free part (columns xi2, u):\n");
    print(RF);
    for i from 1 to 3 do
      printf("Ext^%d: %a\n", i, Exti(Involution(RF, S), S, i)[1]);
    end do:
    printf("=> Ext^1 = Ext^2 = Ext^3 = 0: projective, hence free (Quillen-Suslin)\n");

    ## Bezout equation of the book: r1 m1 + r2 m2 = 1 with
    ##   m1 = -2(1 + e^{-L(d/dt-1)}),  m2 = Dt - 1  (minors of RF)
    m1 := -2*b:  m2 := Dt - 1:
    Rinv := RightInverse(RF, S):
    printf("\nRight inverse of RF (OreModules):\n");
    print(Rinv);
    r2O := Rinv[1, 1]:  r1O := Rinv[2, 1]:
    printf("Bezout coefficients found: r1 = %a, r2 = %a\n", r1O, r2O);
    printf("Check r1 m1 + r2 m2 = %a\n", expand(r1O*m1 + r2O*m2));

    r1 := -1/4:  r2 := dd/2:
    printf("\nCoefficients of the book: r1 = -1/4, r2 = dd/2\n");
    printf("Check r1 m1 + r2 m2 = %a\n", expand(r1*m1 + r2*m2));

    ## Basis omega = r1 xi2 - r2 u and expression of xi2, u in terms of omega
    printf("\nBasis omega = r1 xi2 - r2 u = %a\n", r1*xi2 - r2*u);
    printf("xi2 = m1 omega = (%a) omega,   u = -m2 omega = (%a) omega\n",
           factor(m1), -m2);
    printf("Check: (Dt-1)(m1 omega) - 2 b (-m2 omega) = %a\n",
           expand((Dt - 1)*m1 - 2*b*(-m2)));
    printf("Check: r1 (m1 omega) - r2 (-m2 omega) = %a omega\n",
           expand(r1*m1 + r2*m2));

    ## With OreModules: injective parametrization and left inverse
    PF := Exti(Involution(RF, S), S, 1)[3]:
    printf("\nParametrization of the free part computed by OreModules: (xi2, u)^T = Q xi, Q =\n");
    print(PF);
    Q := evalm([[m1], [-m2]]):
    printf("Parametrization of the book Q = [m1, -m2]^T: RF Q = %a\n",
           map(expand, convert(evalm(RF &* Q), listlist)));
    Linv := LeftInverse(Q, S):
    printf("Left inverse of Q (=> omega as a combination of xi2, u): %a\n",
           convert(Linv, listlist));
    printf("Check Linv Q = %a\n",
           map(expand, convert(evalm(Linv &* Q), listlist)));
  end if:

end do:

quit;
