## =====================================================================
## Section 5.2 -- "A more elaborated example"
## Part 1: model, Fitting ideal, torsion / torsion-freeness /
##         projectivity and decomposition over Rex = R[d/dt, e^{-L d/dt}]
##         (Subsections 5.2.1 and 5.2.1.1 of the book)
##
## Maple conventions:
##   Dt     = d/dt
##   delta  = e^{-L d/dt}   (pure delay, independent of Dt in Rex)
##   E      = e^{L}         (real, strictly positive parameter)
## so that e^{-L(d/dt - 1)} = E*delta.
##
## The coefficients being constant, the Ore algebra defined below is
## the commutative ring Q(E)[Dt, delta], isomorphic to Rex.
## =====================================================================

## Path to the OreModules library (to be adapted to the local installation):
## libname := "/path/to/OreModules", libname:
with(OreModules):
with(LinearAlgebra):
interface(screenwidth = 110):

A := DefineOreAlgebra(diff = [Dt, t], dual_shift = [delta, s],
                      polynom = [t, s], comm = [E]):

## Application of a presentation matrix to a vector of generators
## (Dt and delta commute, so that the formal product is licit).
apply_to := (M, v) -> map(expand, convert(Matrix(M) . Vector(v), list)):

for eps in [1, -1] do

  printf("\n\n####################################################\n");
  printf("#####   epsilon = %2d                             #####\n", eps);
  printf("####################################################\n");

  ## --- Presentation matrix of Lambda_e^epsilon (variables x1, x2, u)
  b := 1 + eps*E*delta:            # 1 + epsilon e^{-L(d/dt-1)}
  R := evalm([[Dt, -1, -b],
              [-1, Dt, -b]]):
  printf("\nPresentation matrix P (columns x1, x2, u):\n");
  print(R);

  ## --- 2x2 minors (m_i = minor obtained by deleting column i)
  RM := Matrix(R):
  m := [seq(factor(Determinant(DeleteColumn(RM, i))), i = 1 .. 3)]:
  printf("\nMinors of order 2 [m1, m2, m3]:\n");
  print(m);

  ## --- Fitting ideal: gcd of the minors and Groebner basis of the quotient
  g := factor(gcd(gcd(m[1], m[2]), m[3])):
  printf("\nGcd of the minors (common factor): %a\n", g);
  q := map(normal, map(z -> z/g, m)):
  printf("Fitt(Lambda_e) = (%a) * < %a >\n", g,
         Groebner:-Basis(q, plex(Dt, delta)));

  ## --- Common zeros of the minors in C^2 (s = Dt, z = delta)
  printf("\nCommon zeros of the minors in C^2:\n");
  print(solve({op(m)}, {Dt, delta}));

  ## --- Extension modules (Ext^i(N, D), N = transposed module of Lambda)
  ##     Ext^1 = 0  <=> torsion-free
  ##     Ext^1 = Ext^2 = 0 (and Ext^3 = 0) <=> projective
  ##     (OreModules returns the matrix [1] or "undefined" for the zero module)
  e1 := Exti(Involution(R, A), A, 1):
  printf("\nExt^1: presentation matrix of the torsion submodule\n");
  print(e1[1]);
  printf("Generators of the torsion (rows of e1[2] applied to [x1,x2,u]):\n");
  print(apply_to(e1[2], [x1, x2, u]));
  printf("=> Lambda_e is NOT torsion-free: torsion generated by xi1 = x1 - x2,\n");
  printf("   with the relation (Dt + 1) xi1 = 0.\n");

  e2 := Exti(Involution(R, A), A, 2):
  printf("\nExt^2:\n");
  print(e2[1]);
  e3 := Exti(Involution(R, A), A, 3):
  printf("Ext^3: %a   (undefined/ZERO = zero module)\n", e3[1]);

  ## ---------------------------------------------------------------
  ## Decomposition (Subsection 5.2.1.1):
  ##   xi1 = x1 - x2, xi2 = x1 + x2.
  ## W: change of variables (xi1, xi2, u) = W (x1, x2, u)
  ## U: combination of the equations. U and W are invertible over R.
  ## ---------------------------------------------------------------
  W := Matrix([[1, -1, 0], [1, 1, 0], [0, 0, 1]]):
  U := Matrix([[1, -1], [1, 1]]):
  Rdec := map(expand, U . RM . MatrixInverse(W)):
  printf("\nAfter the change of variables (xi1, xi2, u): U P W^(-1) =\n");
  print(Rdec);
  printf("=> decoupled system: (Dt+1) xi1 = 0 and (Dt-1) xi2 - 2(1 + eps E delta) u = 0.\n");

  ## --- Torsion part: T = [xi1] / ((Dt+1) xi1)
  RT := evalm([[Dt + 1]]):
  printf("\nTor(Lambda_e): presentation %a, Fitt = (%a)\n",
         convert(RT, listlist), Dt + 1);
  printf("Exti(...,1) for T (T is a torsion module, Ext^1 = T):\n");
  print(Exti(Involution(RT, A), A, 1)[1]);

  ## --- Torsion-free part: F = Lambda_e / Tor(Lambda_e) = [xi2, u]
  RF := evalm([[Dt - 1, -2*b]]):
  printf("\nLambda_e / Tor(Lambda_e): presentation (columns xi2, u)\n");
  print(RF);
  printf("Fitt = < %a >\n", Groebner:-Basis([Dt - 1, 2*b], plex(Dt, delta)));
  printf("Ext^1 (the matrix [1] presents the zero module => torsion-free):\n");
  print(Exti(Involution(RF, A), A, 1)[1]);
  eF2 := Exti(Involution(RF, A), A, 2):
  printf("Ext^2 (0 <=> projective):\n");
  print(eF2[1]);
  printf("Common zero in C^2 of the generators of Fitt: %a\n",
         solve({Dt - 1, b}, {Dt, delta}));
  printf("=> Lambda_e/Tor is torsion-free but NOT projective (hence not free)\n");
  printf("   over Rex = R[d/dt, e^{-L d/dt}], for epsilon = %d.\n", eps);

  ## --- Parametrization of the torsion-free part (image of an operator)
  printf("\nParametrization of Lambda_e/Tor: (xi2, u)^T = Q xi, Q =\n");
  print(Exti(Involution(RF, A), A, 1)[3]);

  ## --- Link with the zeros in s (Laplace): z = e^{-L s}, E = e^{L}
  printf("\nRestriction to the curve z = e^{-L s}:\n");
  printf("  1 + eps*E*delta at s = 1: %a\n",
         simplify(subs(E = exp(L), delta = exp(-L*1), b)));
  printf("  (common zero at s = 1 only if epsilon = -1)\n");

end do:

quit;
